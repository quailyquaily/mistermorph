@@ -43,6 +43,35 @@ const LINE: f32 = 16.0;
 /// `wl_pointer::Event::Axis`), so scrolling runs ahead of every other app.
 const WAYLAND_TOUCHPAD_GAIN: f32 = if cfg!(target_os = "linux") { 3.0 } else { 1.0 };
 
+/// How many times the system's amount a wheel notch or touchpad movement
+/// scrolls. At 1 a notch scrolled 48 points (about two lines of the
+/// console's text) and a touchpad followed the fingers, which felt slow;
+/// at 2 a notch scrolls 96, close to the 100 pixels of browsers on Windows.
+/// macOS reports its own accelerated amounts and keeps them.
+const SCROLL_GAIN: f32 = if cfg!(target_os = "macos") { 1.0 } else { 2.0 };
+
+/// GPUI's scroll delta as nsh's `(dx, dy, precise)`. GPUI's deltas move
+/// the content (positive: down / right); nsh's scroll toward the end.
+/// Ctrl + wheel pinches instead ([`crate::input::wheel`]): its amounts
+/// keep the system's size, so zooming keeps its pace.
+fn scroll_amounts(delta: ScrollDelta, ctrl: bool) -> (f32, f32, bool) {
+    let gain = if ctrl { 1.0 } else { SCROLL_GAIN };
+    match delta {
+        ScrollDelta::Pixels(p) => (
+            -f32::from(p.x) / WAYLAND_TOUCHPAD_GAIN * gain,
+            -f32::from(p.y) / WAYLAND_TOUCHPAD_GAIN * gain,
+            true,
+        ),
+        ScrollDelta::Lines(l) => (-l.x * LINE * gain, -l.y * LINE * gain, false),
+    }
+}
+
+/// Whether a scroll is GPUI's Wayland client reporting the fingers'
+/// lift: an empty precise move.
+fn touchpad_lift(dx: f32, dy: f32, precise: bool) -> bool {
+    precise && cfg!(target_os = "linux") && dx == 0.0 && dy == 0.0
+}
