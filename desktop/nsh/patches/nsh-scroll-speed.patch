+#[cfg(test)]
+mod tests {
+    use gpui::{point, px};
+
+    use super::*;
+
+    fn pixels(x: f32, y: f32) -> ScrollDelta {
+        ScrollDelta::Pixels(point(px(x), px(y)))
+    }
+
+    #[test]
+    fn wheel_lines_scroll_by_the_gain() {
+        // A notch down is three lines up in GPUI's terms (content moves up).
+        let (dx, dy, precise) = scroll_amounts(ScrollDelta::Lines(point(0.0, -3.0)), false);
+        assert!(!precise);
+        assert_eq!(dx, 0.0);
+        assert_eq!(dy, 3.0 * LINE * SCROLL_GAIN);
+        let (dx, dy, _) = scroll_amounts(ScrollDelta::Lines(point(3.0, 3.0)), false);
+        assert_eq!(
+            (dx, dy),
+            (-3.0 * LINE * SCROLL_GAIN, -3.0 * LINE * SCROLL_GAIN)
+        );
+    }
+
+    #[test]
+    fn touchpad_pixels_scroll_by_the_gain_after_the_wayland_divide() {
+        let (dx, dy, precise) = scroll_amounts(pixels(6.0, -12.0), false);
+        assert!(precise);
+        assert_eq!(dx, -6.0 / WAYLAND_TOUCHPAD_GAIN * SCROLL_GAIN);
+        assert_eq!(dy, 12.0 / WAYLAND_TOUCHPAD_GAIN * SCROLL_GAIN);
+    }
+
+    #[test]
+    fn scrolls_faster_than_the_system_off_macos() {
+        let k = if cfg!(target_os = "macos") { 1.0 } else { 2.0 };
+        assert_eq!(SCROLL_GAIN, k);
+        let (_, notch, _) = scroll_amounts(ScrollDelta::Lines(point(0.0, -3.0)), false);
+        assert_eq!(notch, 3.0 * LINE * k);
+    }
+
+    #[test]
+    fn ctrl_keeps_the_systems_amounts_for_zooming() {
+        let (_, dy, _) = scroll_amounts(ScrollDelta::Lines(point(0.0, -1.0)), true);
+        assert_eq!(dy, LINE);
+        let (dx, dy, _) = scroll_amounts(pixels(-9.0, 9.0), true);
+        assert_eq!(
+            (dx, dy),
+            (9.0 / WAYLAND_TOUCHPAD_GAIN, -9.0 / WAYLAND_TOUCHPAD_GAIN)
+        );
+    }
+
+    #[test]
+    fn empty_moves_stay_empty_and_lift_the_fingers() {
+        for ctrl in [false, true] {
+            let (dx, dy, precise) = scroll_amounts(pixels(0.0, 0.0), ctrl);
+            assert_eq!((dx, dy), (0.0, 0.0));
+            assert_eq!(touchpad_lift(dx, dy, precise), cfg!(target_os = "linux"));
+            let (dx, dy, precise) = scroll_amounts(ScrollDelta::Lines(point(0.0, 0.0)), ctrl);
+            assert_eq!((dx, dy), (0.0, 0.0));
+            assert!(!touchpad_lift(dx, dy, precise));
+        }
+        // The smallest move is still a move, not a lift.
+        let (dx, dy, precise) = scroll_amounts(pixels(0.0, 0.01), false);
+        assert!(dy < 0.0);
+        assert!(!touchpad_lift(dx, dy, precise));
+    }
+}
