# Wrangler builds from a generated Dockerfile, so these rules must live at the context root.
# Keep the build context limited to source inputs; never send local credentials.
**
!go.mod
!go.sum
!agent/**
!assets/**
!cmd/mistermorph/**
!contacts/**
!guard/**
!integration/**
!internal/**
!llm/**
!providers/**
!secrets/**
!skills/**
!third_party/ultraviolet/**
!tools/**
!web/console/**
!deploy/cloudflare/Dockerfile
!deploy/cloudflare/start.sh
!deploy/cloudflare/config.example.yaml
**/node_modules
**/dist
**/.git
**/.env
**/.env.*
**/env.sh
**/config.yaml
**/config.runtime.yaml
**/dump
**/*.log
cmd/mistermorph/consolecmd/static/**
