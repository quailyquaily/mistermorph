+
+// reap stops what is left in the server's process group, while its pid still holds the group,
+// and reaps the server.
+func (r *rpc) reap() {
+	r.reapMu.Lock()
+	if !r.reaping {
+		r.reaping = true
+		_ = r.cmd.Cancel()
+	}
+	r.reapMu.Unlock()
+	r.wait()
+}
