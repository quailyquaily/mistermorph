{
  "name": "Mister Morph",
  "id": "com.mistermorph.console",
  "version": "0.1.0",
  "build": 1,
  "appearance": "light",
  "theme": "theme.json",
  "icon": "assets/apple-touch-icon.png",
  "capabilities": {
    "network": {
      "hosts": [
        "*"
      ]
    },
    "webview": {
      "hosts": [
        "*"
      ],
      "media": [
        "camera"
      ]
    },
    "clipboard": true,
    "picker": true,
    "openUrl": {
      "schemes": [
        "http",
        "https",
        "mailto"
      ]
    },
    "host": [
      "morph.*"
    ],
    "speech": true,
    "fs": {
      "read": [
        "${dataDir}/cache"
      ],
      "write": [
        "${dataDir}/cache"
      ]
    },
    "statusBar": true
  },
  "web": {
    "host": "./host.js"
  },
  "ios": {
    "infoPlist": {
      "ITSAppUsesNonExemptEncryption": false,
      "NSAppTransportSecurity": {
        "NSAllowsArbitraryLoads": true
      },
      "NSLocalNetworkUsageDescription": "Morph connects to your Mister Morph server on the local network.",
      "NSCameraUsageDescription": "Morph uses the camera to scan the QR code of your Mister Morph server's address."
    }
  }
}
