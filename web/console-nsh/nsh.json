{
  "name": "Mister Morph",
  "id": "com.mistermorph.console",
  "version": "0.1.0",
  "build": 1,
  "appearance": "light",
  "theme": "theme.json",
  "icon": "assets/apple-touch-icon.png",
  "capabilities": {
    "network": {
      "hosts": [
        "*"
      ]
    },
    "webview": {
      "hosts": [
        "*"
      ]
    },
    "clipboard": true,
    "picker": true,
    "openUrl": {
      "schemes": [
        "http",
        "https",
        "mailto"
      ]
    },
    "host": [
      "morph.*"
    ],
    "speech": true,
    "statusBar": true
  },
  "web": {
    "host": "./host.js"
  },
  "ios": {
    "infoPlist": {
      "NSAppTransportSecurity": {
        "NSAllowsArbitraryLoads": true
      },
      "NSLocalNetworkUsageDescription": "Morph connects to your Mister Morph server on the local network."
    }
  }
}
